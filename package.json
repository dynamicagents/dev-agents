{
  "name": "dev-agents",
  "private": true,
  "type": "module",
  "description": "The workspace that holds the Dynamic Agents repos and the skills they share.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "skills": "node .agents/skills/superproject/scripts/skills.mjs",
    "skills:check": "node .agents/skills/superproject/scripts/skills.mjs --check",
    "submodules:check": "node .agents/skills/superproject/scripts/submodules.mjs --check",
    "test": "node --test scripts/*.test.mjs",
    "check": "npm run skills:check && npm run submodules:check && npm test",
    "bootstrap": "node .agents/skills/superproject/scripts/bootstrap.mjs",
    "sync": "node .agents/skills/superproject/scripts/sync.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
